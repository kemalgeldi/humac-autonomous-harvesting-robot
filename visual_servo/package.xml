<?xml version="1.0"?>
<package format="2">
  <name>visual_servo</name>
  <version>0.1.0</version>
  <description>Visual navigation, RGB-D tree mapping and mission control for the HUMAC harvesting robot prototype.</description>
  <maintainer email="gurbanniyazovich04@gmail.com">Kemalgeldi Gurbannyyazov</maintainer>
  <author>Kemalgeldi Gurbannyyazov</author>
  <license>Unspecified</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <export/>
</package>
